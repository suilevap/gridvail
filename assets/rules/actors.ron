// Who is who on a map, and what they fight with.
(
    // Weapons: damage, turns wound up between aiming and the strike, the
    // cells they cover, drawn with the wielder `@` facing up and each struck
    // cell a digit in the order the swing goes through them (or all `x`),
    // and how they are swung (how far, in cells: `Thrust` straight
    // at the target, `Sweep` in an arc across the front, `Hook` out and
    // pulled back; a thrust when not given), and the streak each leaves (an
    // effect in `assets/effects`; none when not given).
    weapons: {
        // The cell in front.
        "jab": (damage: 1, windup: 1, swing: Thrust(reach: 0.55), streak: "swoosh", art: "
            x
            @
        "),
        // The whole row in front: stepping aside is no escape.
        "sweep": (damage: 1, windup: 1, swing: Sweep(reach: 0.6), streak: "swoosh",
            art: "
            123
            .@.
        "),
        // Two cells straight ahead: stepping back is no escape.
        "spear": (damage: 1, windup: 1, swing: Thrust(reach: 0.95), streak: "swoosh",
            art: "
            2
            1
            @
        "),
    },

    // Fighting styles: a move for each way a swipe can go from where the
    // mover faces (forward, left, right, back). A move plays when one of its
    // cells (drawn as for weapons, the mover `@` facing up) holds a target;
    // otherwise the swipe is a plain step. It hits each target in its cells
    // in order (only the first, with `stop: true`) for `hit` damage, and
    // knocks each `knock` cells the way the swing goes through its cell (1
    // for now: a body moves its whole speed in one movement pass). `stance`
    // is where it leaves the mover: `Stay`, `Follow` into the cell the first
    // knocked target leaves, or `Step` the way of the swipe; with `turn` the
    // mover turns to face the swipe. `swing` and `streak` are how it looks,
    // as for weapons (no swing when not given).
    moves: {
        "blade": (
            // Into what is ahead, knocking it on and taking its cell.
            forward: (name: "lunge", hit: 1, knock: 1, stance: Follow,
                swing: Thrust(reach: 0.6), streak: "swoosh", art: "
                1
                @
            "),
            // Round from ahead to the side, turning to face it: what is
            // ahead is swept aside, what is beside is swept back.
            left: (name: "sweep left", hit: 1, knock: 1, turn: true,
                swing: Sweep(reach: 0.55), streak: "swoosh", art: "
                21
                3@
            "),
            right: (name: "sweep right", hit: 1, knock: 1, turn: true,
                swing: Sweep(reach: 0.55), streak: "swoosh", art: "
                12
                @3
            "),
            // Facing something, a step back keeps facing it.
            back: (name: "back off", stance: Step, art: "
                x
                @
            "),
        ),
    },

    // Actors by map glyph: a name, the behaviour they run (the player runs
    // none), hit points, their weapon or moves, and what a blow knocks out
    // of them (an effect in `assets/effects`).
    actors: {
        'p': (name: "player", hp: 2, moves: "blade", bleeds: "blood"),
        'e': (name: "guard", tree: Enemy, hp: 2, weapon: "sweep", bleeds: "blood"),
        's': (name: "spearman", tree: Enemy, hp: 2, weapon: "spear", bleeds: "blood"),
        'h': (name: "hunter", tree: Hunter, hp: 2, weapon: "jab", bleeds: "blood"),
    },
)
